# Keep shell scripts LF-only: deploy-travium-docker.sh runs on Linux, and a
# CRLF shebang makes bash fail with "bad interpreter".
*.sh text eol=lf
deploy-travium-docker.sh text eol=lf

# The PHP backport patch is fed to `patch -p1` inside the Linux build image. A
# CRLF patch does not match LF sources, so a Windows checkout with autocrlf=true
# would break the build if this file were converted.
*.patch text eol=lf

# Helper scripts: same reason (they are run on the host, and diffed).
*.py text eol=lf

# Normalise text files.
*.php text
*.js text
*.css text
*.sql text
*.twig text
*.json text

# Binary assets must not be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.svg text
